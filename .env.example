# Copy this file to .env (never commit .env).

# local    = in-memory PostgreSQL loaded from database/schema.sql + seed.sql (no setup)
# supabase = your Supabase PostgreSQL database
DATA_MODE=local
PORT=3000

# For supabase mode: run database/schema.sql and seed.sql in the Supabase
# SQL Editor first, then paste the connection string from
# Supabase -> Connect -> Session pooler. It contains the database password,
# so it must stay on the server only.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
