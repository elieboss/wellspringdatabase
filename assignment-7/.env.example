# Copy this file to .env and fill in the values. Never commit .env.

# Long random text used to sign the sign-in cookie. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

PORT=3000

# local    = PostgreSQL (PGlite) stored in ./data/pgdata. Created and
#            loaded with database/wellspring.sql + accounts.sql on first run.
# postgres = your own PostgreSQL or Supabase database (set DATABASE_URL).
DATA_MODE=local

# Only for DATA_MODE=postgres. Run database/wellspring.sql and then
# database/accounts.sql in that database first. The URL contains the
# database password, so it stays on the server only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional, for DATA_MODE=postgres with Supabase: path to the CA
# certificate downloaded from Supabase (Database settings -> SSL).
# DATABASE_CA_CERT=./prod-ca-2021.crt
